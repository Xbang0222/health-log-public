#!/bin/sh
# 提交前跑全库校验；不通过就取消这次提交。
project_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' "找不到当前 Git 项目，提交前没法检查数据，提交已取消。" >&2
  exit 1
}
cd "$project_root" || exit 1
# .hl/ 下是签名密钥、用户原话：不进 git。看的是这次要提交的暂存区
hidden=$(git ls-files -- .hl)
if [ -n "$hidden" ]; then
  printf '%s\n' "暂存区里有 .hl/ 下的文件（签名密钥、用户原话，不进 git），提交已取消：" "$hidden" \
    "运行 git rm -r --cached -f -q -- .hl，把它们拿出暂存区（文件本身不动）。" >&2
  # 数据目录的 .gitignore 用 ! 规则把 .hl 这个文件夹放了出来：.git/info/exclude 盖不过，hl init
  # 帮不上。只放出里面某类文件的（!*.json）盖得过：文件夹被忽略之后，里面的文件放不出来
  negation='^([^/:][^:]*/)?\.gitignore:[0-9]+:!'
  if printf '%s\n' .hl | git check-ignore -v -n --no-index --stdin | grep -qE "$negation"; then
    opened=$(printf '%s\n' .hl "$hidden" | git check-ignore -v -n --no-index --stdin |
      grep -E "$negation")
    printf '%s\n' "{not_excluded}（是下面这几条）：" "$opened" "改好之后重新提交。" >&2
  elif [ "$(printf '%s\n' "$hidden" | git check-ignore --no-index --stdin)" != "$hidden" ]; then
    printf '%s\n' "再运行 hl init，让 git 以后忽略 .hl/；然后重新提交。" >&2
  else
    printf '%s\n' "然后重新提交。" >&2
  fi
  exit 1
fi
# check 读取工作区；先保证本次暂存的账本正是将被检查的字节。
# --no-renames 将重命名拆成删除和新增；删除后恢复为 untracked 也必须拒绝。
if ! python3 - <<'PY'
import os
import stat
import subprocess
import sys

protected = {protected_paths_json}

def git(*args):
    return subprocess.check_output(["git", "--literal-pathspecs", *args], stderr=subprocess.PIPE)

def ledger(name):
    path = os.fsdecode(name).casefold()
    return any(path == p.rstrip("/") or p.endswith("/") and path.startswith(p)
               for p in protected)

try:
    for name in git("ls-files", "-z").split(b"\0"):
        if name and os.fsdecode(name).split("/", 1)[0].casefold() == ".hl":
            raise ValueError("暂存区含私有 .hl 路径，不能提交：" + repr(os.fsdecode(name)))
    changed = [p for p in git("diff", "--cached", "--name-only", "-z", "--no-renames").split(b"\0")
               if p and ledger(p)]
    if changed:
        index = {}
        for entry in git("ls-files", "--stage", "-z", "--", *changed).split(b"\0"):
            if not entry:
                continue
            metadata, name = entry.split(b"\t", 1)
            mode, blob, stage = metadata.split()
            if stage != b"0" or mode not in (b"100644", b"100755"):
                raise ValueError("暂存账本不是已解决冲突的普通文件：" + repr(os.fsdecode(name)))
            index[name] = blob
        for name in changed:
            label = repr(os.fsdecode(name))
            if name not in index:
                if os.path.lexists(name):
                    raise ValueError("暂存删除的账本仍存在于工作区：" + label)
                continue
            parent = os.path.dirname(name)
            while parent:
                if not stat.S_ISDIR(os.lstat(parent).st_mode):
                    raise ValueError("账本父路径不是普通目录：" + label)
                parent = os.path.dirname(parent)
            if not stat.S_ISREG(os.lstat(name).st_mode):
                raise ValueError("工作区账本不是普通文件：" + label)
            if git("hash-object", "--no-filters", "--", name).strip() != index[name]:
                raise ValueError("暂存账本与工作区内容不同：" + label)
except (OSError, ValueError, subprocess.SubprocessError) as exc:
    print("无法确认暂存账本与工作区一致：" + str(exc), file=sys.stderr)
    sys.exit(1)
PY
then
  printf '%s\n' "提交已取消。请让本次暂存的账本文件与工作区字节、存在状态一致，再重新提交。" >&2
  exit 1
fi
# 本地程序存在时只运行它；缺依赖或检查失败不能改用另一套全局引擎。
check_ledger() {
  if [ -e "$project_root/scripts/hl.py" ] || [ -L "$project_root/scripts/hl.py" ]; then
    if [ ! -f "$project_root/scripts/hl.py" ]; then
      printf '%s\n' "本项目 scripts/hl.py 不是可读程序文件，请先修复本地程序。" >&2
      return 1
    fi
    python3 "$project_root/scripts/hl.py" --data "$project_root" check
  else
    # 尚未包含源码的旧独立账本保留原入口；仍绑定当前 Git 根，不采用外部 HL_DATA。
    command -v hl >/dev/null 2>&1 || {
      printf '%s\n' "本项目没有 scripts/hl.py，PATH 里也找不到 hl，未执行账本检查。" >&2
      return 1
    }
    HL_DATA="$project_root" hl check
  fi
}
out=$(check_ledger 2>&1) || {
  printf '%s\n' "账本检查没有通过，提交已取消。请运行本项目的 check 查看问题和改法。" "$out" >&2
  exit 1
}

{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "hl hook user-prompt --agent codex"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "hl hook pre-tool --agent codex"}
        ]
      }
    ]
  }
}

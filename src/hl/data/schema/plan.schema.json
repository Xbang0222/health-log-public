{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan.yaml 的结构",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "from",
      "default",
      "days",
      "said",
      "sig"
    ],
    "properties": {
      "from": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "default": {
        "type": "string",
        "minLength": 1
      },
      "days": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "\\S"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kcal"
          ],
          "properties": {
            "kcal": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "protein": {
              "type": "number",
              "minimum": 0
            },
            "fat": {
              "type": "number",
              "minimum": 0
            },
            "carb": {
              "type": "number",
              "minimum": 0
            },
            "fiber": {
              "type": "number",
              "minimum": 0
            },
            "sodium": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "said": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "answers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sig": {
        "type": "string"
      },
      "revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "每日记录 log/YYYY/MM/DD.yaml 的结构",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "entries"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "day_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "said",
        "sig"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "said": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kg",
        "said",
        "sig"
      ],
      "properties": {
        "kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "said": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "meal",
          "said",
          "items",
          "sig"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "key": {
            "type": "string"
          },
          "meal": {
            "enum": [
              "早餐",
              "午餐",
              "晚餐",
              "加餐"
            ]
          },
          "said": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "food",
                "name",
                "kcal",
                "protein",
                "fat",
                "carb",
                "fiber",
                "sodium",
                "src",
                "est"
              ],
              "$comment": "est 行和按个、份记的 my: 行没有 g，其余 g 必填（增补第 13.1 节）",
              "if": {
                "properties": {
                  "food": {
                    "pattern": "^(cn6|bh|x):"
                  }
                }
              },
              "then": {
                "required": [
                  "g"
                ]
              },
              "properties": {
                "food": {
                  "$comment": "写法见增补第 13.1 节；只有 foods/table.py 认这些前缀",
                  "type": "string",
                  "pattern": "^((cn6|bh):[0-9A-Za-z_-]+|x:salt|my:\\S(.*\\S)?|est)$"
                },
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "g": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "kcal": {
                  "type": "number",
                  "minimum": 0
                },
                "protein": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "fat": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "carb": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "fiber": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "sodium": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "src": {
                  "enum": [
                    "成分表",
                    "包装标签",
                    "熟重折算",
                    "菜谱估算",
                    "薄荷库",
                    "模型估算",
                    "用户估算",
                    "做法估算"
                  ]
                },
                "est": {
                  "$comment": "估算标记（增补第 12 节）；true、false 是第 1 步写下的旧格式，照读",
                  "type": [
                    "array",
                    "boolean"
                  ],
                  "items": {
                    "enum": [
                      "amount",
                      "content"
                    ]
                  },
                  "uniqueItems": true
                },
                "part_of": {
                  "type": "string"
                },
                "item_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "sig": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "origin": {
            "type": "object",
            "required": [
              "kind",
              "said",
              "at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "agent-reported",
                  "host-captured"
                ]
              },
              "said": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "answers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "message_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "session": {
                "type": "string"
              },
              "said_source": {
                "enum": [
                  "agent-reported",
                  "host-captured"
                ]
              },
              "answers_source": {
                "enum": [
                  "agent-reported",
                  "host-captured"
                ]
              }
            },
            "additionalProperties": false
          },
          "input_items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "name"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "object",
                  "required": [
                    "n",
                    "unit"
                  ],
                  "properties": {
                    "n": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "variant": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "生",
                    "熟"
                  ]
                },
                "net": {
                  "enum": [
                    "带皮",
                    "去皮"
                  ]
                },
                "approximate": {
                  "type": "boolean"
                },
                "food": {
                  "type": "string"
                },
                "estimate": {
                  "type": "object"
                },
                "legacy": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}

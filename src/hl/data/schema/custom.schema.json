{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "用户库 foods/custom.yaml 的结构（增补第 13.1 节）",
  "x-hint": "用户库只能由 hl add（存下估算）和 hl food add 写入，不能直接改；改坏了用 git 恢复",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sig"
    ],
    "$comment": "三种：包装标签（per、nutrition，src 是包装标签）；存下来的估算（per 和 parts 或 nutrition，带 est、basis）；量词补充（只有 units）",
    "dependentRequired": {
      "parts": [
        "per",
        "src",
        "est",
        "date"
      ],
      "nutrition": [
        "per",
        "src",
        "est",
        "date"
      ],
      "per": [
        "src",
        "est",
        "date"
      ]
    },
    "not": {
      "required": [
        "parts",
        "nutrition"
      ]
    },
    "properties": {
      "per": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "g"
            ],
            "properties": {
              "g": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ml"
            ],
            "properties": {
              "ml": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "unit"
            ],
            "properties": {
              "n": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "parts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "food",
            "g"
          ],
          "properties": {
            "food": {
              "type": "string",
              "pattern": "^((cn6|bh):[0-9A-Za-z_-]+|x:salt)$"
            },
            "g": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "nutrition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kcal",
          "protein",
          "fat",
          "carb",
          "fiber",
          "sodium"
        ],
        "properties": {
          "kcal": {
            "type": "number",
            "minimum": 0
          },
          "protein": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "carb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fiber": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sodium": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "src": {
        "enum": [
          "包装标签",
          "用户估算",
          "模型估算"
        ]
      },
      "est": {
        "type": "array",
        "items": {
          "enum": [
            "content"
          ]
        }
      },
      "serving_g": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "units": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "g",
            "date"
          ],
          "properties": {
            "g": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "from": {
              "$ref": "#/$defs/from"
            }
          }
        }
      },
      "basis": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1
      },
      "said": {
        "type": "string",
        "minLength": 1
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "from": {
        "$ref": "#/$defs/from"
      },
      "sig": {
        "type": "string"
      },
      "revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    }
  },
  "$defs": {
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "id"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "id": {
          "type": "string",
          "pattern": "^e[0-9]+$"
        }
      }
    }
  }
}

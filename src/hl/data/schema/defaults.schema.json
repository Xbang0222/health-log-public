{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "defaults.yaml 的结构",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "variant",
      "said",
      "sig"
    ],
    "properties": {
      "variant": {
        "type": "string",
        "minLength": 1
      },
      "said": {
        "type": "string",
        "minLength": 1
      },
      "sig": {
        "type": "string"
      },
      "revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    }
  }
}

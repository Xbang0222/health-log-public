{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "引擎自带的参考范围表 reference.yaml 的结构（设计说明第 7.5 节）",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "items"],
  "x-hint": "reference.yaml 随引擎发布：只有 sources 和 items 两个键",
  "properties": {
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "by", "url", "kind"],
        "x-hint": "每个出处写 name、by、url、kind 四样；kind 只能是 官方文件、文献、行业惯例",
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "by": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "kind": {"enum": ["官方文件", "文献", "行业惯例"]}
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "what", "who", "high", "unit", "source", "checked", "where", "note"],
        "x-hint": "每条写 id、topic、what、who、low 和 high（只有上限的写 high 和 upper）、unit、source、checked、where、note",
        "oneOf": [
          {"required": ["low"], "not": {"required": ["upper"]}},
          {"required": ["upper"], "not": {"required": ["low"]}}
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "topic": {"enum": ["蛋白质", "脂肪", "碳水", "纤维", "钠", "盐", "烹调油", "减重速度"]},
          "what": {"type": "string", "minLength": 1},
          "who": {"type": "string", "minLength": 1},
          "low": {"type": "number", "minimum": 0},
          "high": {"type": "number", "exclusiveMinimum": 0},
          "upper": {"enum": ["≤", "<"]},
          "unit": {"enum": ["g/d", "mg/d", "%E", "g/kg/d", "g/kg_lbm/d", "%bw/wk"]},
          "source": {"type": "string", "minLength": 1},
          "checked": {"enum": ["已核对原文", "未核对原文"]},
          "where": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
